# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (sb_secret_… or the legacy service_role key). Server-only:
# no NEXT_PUBLIC_ prefix, so it never reaches the browser. It bypasses RLS —
# the app's own login and guards (src/lib/auth.ts) decide who sees what.
SUPABASE_SECRET_KEY=

# Sign-in code emails, sent with Resend (https://resend.com). EMAIL_FROM must
# be on a domain verified in Resend. Leave both empty in local development to
# have the code printed in the dev-server console instead.
RESEND_API_KEY=
EMAIL_FROM="APEL.Q Tracker <no-reply@your-verified-domain>"
